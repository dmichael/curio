#!/bin/sh
set -eu

DATA_HOME=${XDG_DATA_HOME:-"$HOME/.local/share"}
CONFIG_HOME=${XDG_CONFIG_HOME:-"$HOME/.config"}
ENV_FILE=${CURIO_ENV_FILE:-"$CONFIG_HOME/curio/curio.env"}
read_env() { [ -f "$1" ] && awk -F= -v k="$2" '$1 == k {sub(/^[^=]*=/, ""); print; exit}' "$1"; }
# CURIO_APP_ROOT in the persisted configuration wins over the XDG default, so
# custom-root installs are discoverable when the wrapper is invoked from any cwd.
APP_ROOT=${CURIO_APP_ROOT:-$(read_env "$ENV_FILE" CURIO_APP_ROOT)}
APP_ROOT=${APP_ROOT:-"$DATA_HOME/curio/app"}
DOCKER_BIN=${CURIO_DOCKER_BIN:-docker}
PROJECT_NAME=${CURIO_PROJECT_NAME:-curio}
COMPOSE_FILE=${CURIO_COMPOSE_FILE:-"$APP_ROOT/current/compose.yaml"}

fail() { echo "curio: $*" >&2; exit 1; }
valid_release_version() {
    case "$1" in v*) release_numbers=${1#v} ;; *) return 1 ;; esac
    case "$release_numbers" in ''|.*|*.|*..*|*[!0-9.]*) return 1 ;; esac
    old_ifs=$IFS; IFS=.; set -- $release_numbers; IFS=$old_ifs
    [ "$#" -eq 3 ] && [ -n "$1" ] && [ -n "$2" ] && [ -n "$3" ]
}
require_installation() {
    [ -f "$COMPOSE_FILE" ] || fail "installation not found: $COMPOSE_FILE"
    [ -f "$ENV_FILE" ] || fail "configuration not found: $ENV_FILE"
    command -v "$DOCKER_BIN" >/dev/null 2>&1 || fail "Docker is not available"
}
# Compose stats the caller's working directory; run from / so any cwd works.
compose() { (cd / && "$DOCKER_BIN" compose --project-name "$PROJECT_NAME" --env-file "$ENV_FILE" --file "$COMPOSE_FILE" "$@"); }
version() { [ -f "$APP_ROOT/current/VERSION" ] || fail "installed version is unavailable"; cat "$APP_ROOT/current/VERSION"; }
release_base() {
    base=${CURIO_RELEASE_BASE_URL:-https://github.com/${CURIO_GITHUB_REPOSITORY:-dmichael/curio}/releases}
    printf '%s' "${base%/}"
}
latest_release() {
    command -v curl >/dev/null 2>&1 || fail "curl is required for updates"
    latest=$(curl -fsSL --connect-timeout 10 --max-time 60 --retry 3 "$(release_base)/latest/download/VERSION" 2>/dev/null) \
        || fail "could not fetch latest VERSION"
    valid_release_version "$latest" || fail "latest release does not publish a valid VERSION"
    printf '%s' "$latest"
}
check_update() {
    latest=$(latest_release)
    current=$(version); printf 'installed %s; latest %s\n' "$current" "$latest"; [ "v$current" != "$latest" ]
}
update() {
    requested=${1:-}
    if [ -z "$requested" ]; then requested=$(latest_release); fi
    valid_release_version "$requested" || fail "version must look like vX.Y.Z"
    require_installation
    CURIO_APP_ROOT="$APP_ROOT" CURIO_VERSION="$requested" "$APP_ROOT/current/install.sh"
}
command=${1:-}; [ -n "$command" ] || fail "usage: curio {start|stop|restart|status|logs|health|version|update}"
shift || true
case "$command" in
    version) [ "$#" -eq 0 ] || fail "version takes no arguments"; version ;;
    update) case "${1:-}" in --check) [ "$#" -eq 1 ] || fail "update --check takes no other arguments"; check_update ;; --version) [ "$#" -eq 2 ] || fail "usage: curio update --version vX.Y.Z"; update "$2" ;; '') update ;; *) fail "usage: curio update [--check|--version vX.Y.Z]";; esac ;;
    start|stop|status|logs) require_installation; compose "$command" "$@" ;;
    restart) require_installation; compose restart "$@" ;;
    health) require_installation; compose exec -T resolver python -c 'import urllib.request; print(urllib.request.urlopen("http://127.0.0.1:8090/healthz").read().decode())' ;;
    *) fail "unknown command '$command'" ;;
esac
