#!/bin/sh
set -u

COMPOSE_FILE=${CURIO_COMPOSE_FILE:-/opt/curio/compose.yaml}
ENV_FILE=${CURIO_ENV_FILE:-/etc/curio/curio.env}
PROJECT_NAME=${CURIO_PROJECT_NAME:-curio}
DOCKER_BIN=${CURIO_DOCKER_BIN:-docker}
SERVICES="resolver kubo ar-io-core ar-io-envoy ar-io-redis ar-io-observer"

usage() {
    cat <<'EOF'
Usage:
  curio start
  curio stop
  curio restart [service]
  curio status
  curio health
  curio logs [service] [--follow] [--tail N]
EOF
}

fail() {
    echo "curio: $*" >&2
    exit 1
}

compose() {
    "$DOCKER_BIN" compose \
        --project-name "$PROJECT_NAME" \
        --env-file "$ENV_FILE" \
        --file "$COMPOSE_FILE" \
        "$@"
}

valid_service() {
    wanted=$1
    for service in $SERVICES; do
        [ "$wanted" = "$service" ] && return 0
    done
    return 1
}

require_installation() {
    [ -f "$COMPOSE_FILE" ] || fail "installation not found: missing $COMPOSE_FILE"
    [ -f "$ENV_FILE" ] || fail "configuration not found: missing $ENV_FILE"
    command -v "$DOCKER_BIN" >/dev/null 2>&1 || fail "Docker is not installed or not in PATH"
    "$DOCKER_BIN" compose version >/dev/null 2>&1 \
        || fail "the Docker Compose plugin is unavailable"
}

show_health() {
    result=0
    for service in $SERVICES; do
        container_id=$(compose ps --all --quiet "$service" 2>/dev/null || true)
        if [ -z "$container_id" ]; then
            echo "FAIL $service: no container"
            result=1
            continue
        fi

        state=$("$DOCKER_BIN" inspect --format '{{.State.Status}}' "$container_id" 2>/dev/null || true)
        health=$("$DOCKER_BIN" inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$container_id" 2>/dev/null || true)
        if [ "$state" != "running" ]; then
            echo "FAIL $service: ${state:-unknown state}"
            result=1
        elif [ "$health" = "unhealthy" ] || [ "$health" = "starting" ] || [ -z "$health" ]; then
            echo "FAIL $service: health=${health:-unknown}"
            result=1
        else
            if [ "$health" = "none" ]; then
                echo "OK   $service: running"
            else
                echo "OK   $service: $health"
            fi
        fi
    done

    echo "--- resolver aggregate ---"
    if ! compose exec -T resolver python - <<'PY'
import json
import sys
import urllib.error
import urllib.request

try:
    with urllib.request.urlopen("http://127.0.0.1:8090/healthz", timeout=5) as response:
        payload = response.read().decode()
        status = response.status
except urllib.error.HTTPError as exc:
    payload = exc.read().decode()
    status = exc.code
except Exception as exc:
    print(f"FAIL resolver: {type(exc).__name__}: {exc}")
    raise SystemExit(1)

try:
    print(json.dumps(json.loads(payload), indent=2, sort_keys=True))
except json.JSONDecodeError:
    print(payload)
if status != 200:
    raise SystemExit(1)
PY
    then
        result=1
    fi
    return "$result"
}

require_installation

command=${1:-}
[ -n "$command" ] || { usage >&2; exit 2; }
shift

case "$command" in
    start)
        [ "$#" -eq 0 ] || fail "start does not accept a service; use restart [service]"
        exec "$DOCKER_BIN" compose --project-name "$PROJECT_NAME" --env-file "$ENV_FILE" --file "$COMPOSE_FILE" up --detach
        ;;
    stop)
        [ "$#" -eq 0 ] || fail "stop does not accept a service"
        exec "$DOCKER_BIN" compose --project-name "$PROJECT_NAME" --env-file "$ENV_FILE" --file "$COMPOSE_FILE" stop
        ;;
    restart)
        [ "$#" -le 1 ] || fail "restart accepts at most one service"
        if [ "$#" -eq 1 ]; then
            valid_service "$1" || fail "unknown service '$1' (want one of: $SERVICES)"
        fi
        exec "$DOCKER_BIN" compose --project-name "$PROJECT_NAME" --env-file "$ENV_FILE" --file "$COMPOSE_FILE" restart "$@"
        ;;
    status)
        [ "$#" -eq 0 ] || fail "status does not accept arguments"
        exec "$DOCKER_BIN" compose --project-name "$PROJECT_NAME" --env-file "$ENV_FILE" --file "$COMPOSE_FILE" ps
        ;;
    health)
        [ "$#" -eq 0 ] || fail "health does not accept arguments"
        show_health
        ;;
    logs)
        service=""
        if [ "$#" -gt 0 ]; then
            case "$1" in
                -*) ;;
                *)
                    valid_service "$1" || fail "unknown service '$1' (want one of: $SERVICES)"
                    service=$1
                    shift
                    ;;
            esac
        fi
        if [ -n "$service" ]; then
            set -- "$@" "$service"
        fi
        exec "$DOCKER_BIN" compose --project-name "$PROJECT_NAME" --env-file "$ENV_FILE" --file "$COMPOSE_FILE" logs --tail 200 "$@"
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        usage >&2
        fail "unknown command '$command'"
        ;;
esac
