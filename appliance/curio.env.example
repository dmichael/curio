# Per-user Curio configuration. The installer creates a random curator token.
CURIO_DATA_ROOT=$HOME/.local/share/curio/state
CURIO_CURATOR_TOKEN=replace-with-a-long-random-secret
CURIO_PORT=8090
CURIO_IPFS_STORAGE_MAX=20GB
CURIO_REDIS_MAX_MEMORY=256mb
CURIO_AR_IO_CACHE_CLEANUP_THRESHOLD=2592000
# Set true only when the fronting proxy is trusted to supply forwarded headers.
CURIO_TRUSTED_PROXY_HEADERS=false
