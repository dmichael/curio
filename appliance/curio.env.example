# Curio's LAN IPv4 address. Renderers use this address in resolved URLs.
CURIO_LAN_ADDRESS=192.168.1.50

# Persistent bind-mount root. Changing this after installation points Curio at
# a different state tree; it does not move existing data.
CURIO_DATA_ROOT=/var/lib/curio

# Kubo and cache bounds suitable for the reference SBC.
CURIO_IPFS_STORAGE_MAX=20GB
CURIO_REDIS_MAX_MEMORY=256mb
CURIO_AR_IO_CACHE_CLEANUP_THRESHOLD=2592000
