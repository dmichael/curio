# Per-user Curio configuration. The installer creates a random curator token.
# These defaults use the usual XDG locations; configure custom absolute roots
# before first installation.
CURIO_APP_ROOT=$HOME/.local/share/curio/app
CURIO_DATA_ROOT=$HOME/.local/share/curio/state
CURIO_CURATOR_TOKEN=replace-with-a-long-random-secret
CURIO_PORT=8090
CURIO_IPFS_STORAGE_MAX=20GB
CURIO_REDIS_MAX_MEMORY=256mb
CURIO_AR_IO_CACHE_CLEANUP_THRESHOLD=2592000
# Seconds allowed for Core to retrieve a cold Arweave transaction (not health checks).
CURIO_ARWEAVE_COLD_TIMEOUT=300
# Optional external origin for non-request MCP/proxy use. Forwarded headers
# are not consumed by this revision.
CURIO_PUBLIC_BASE_URL=
